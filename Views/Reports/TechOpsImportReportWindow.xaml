<Window x:Class="AGR_PropManager.Views.Reports.TechOpsImportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AGR_PropManager.Views.Reports"
             xmlns:vmRep="clr-namespace:AGR_PropManager.ViewModels.Reports"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vmRep:TechOpsImportReportViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Style/PartComponentStyle.xaml"/>
                <ResourceDictionary Source="../Style/SpecificationStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Button and status bar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
            <TextBlock Text="Отчет импорта техопераций" FontSize="18" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button Content="Сохранить в Excel" Command="{Binding ExportToExcelCommand}"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" Style="{StaticResource PropertiesDataGrid}"
                  ItemsSource="{Binding ReportData, Mode=OneWay}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Vertical"
                  VerticalGridLinesBrush="LightGray"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="10"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="SizeToCells"
                                    ElementStyle="{StaticResource CenterAlignedTextStyle}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding ComponentName}" Width="SizeToCells" ElementStyle="{StaticResource LeftAlignedTextStyle}"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article, TargetNullValue=''}" Width="*" ElementStyle="{StaticResource CenterAlignedTextStyle}"/>
                <DataGridTextColumn Header="Partnumber" Binding="{Binding Partnumber}" Width="*" ElementStyle="{StaticResource CenterAlignedTextStyle}"/>
                <DataGridTextColumn Header="Порядок" Binding="{Binding Order}" Width="0.5*" ElementStyle="{StaticResource CenterAlignedTextStyle}"/>
                <DataGridTextColumn Header="Операция" Binding="{Binding OperationName}" Width="*" ElementStyle="{StaticResource LeftAlignedTextStyle}"/>
                <DataGridTextColumn Header="Трудоемкость" Binding="{Binding LabourIntensity, StringFormat=F3}" Width="0.6*" ElementStyle="{StaticResource CenterAlignedTextStyle}"/>

                <DataGridTextColumn Header="Доступность" Binding="{Binding Availability}" Width="0.5*" ElementStyle="{StaticResource CenterAlignedTextStyle}"/>
                <DataGridTextColumn Header="Добавочная" Binding="{Binding Additional}" Width="0.5*" ElementStyle="{StaticResource CenterAlignedTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

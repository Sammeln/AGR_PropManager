<!-- File: Views/TechProcessEditorWindow.xaml -->
<Window x:Class="AGR_PropManager.Views.TechProcessEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vmComp="clr-namespace:AGR_PropManager.ViewModels.Components"
        xmlns:vmWindows="clr-namespace:AGR_PropManager.ViewModels.Windows"
        xmlns:b="clr-namespace:AGR_PropManager.Infrastructure.Behaviors"
        xmlns:AGR_Behavors="clr-namespace:AgroventInfrastructure.Behaviors;assembly=AgroventInfrastructure"
        xmlns:enums="clr-namespace:AgroventInfrastructure.Enums;assembly=AgroventInfrastructure"
        xmlns:AGR_converter="clr-namespace:AgroventInfrastructure.AGR_Converters;assembly=AgroventInfrastructure"
        mc:Ignorable="d"
        Title="Редактор технологического процесса"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=vmWindows:TechProcessEditorViewModel, IsDesignTimeCreatable=True}"
       >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/SpecificationStyle.xaml"/>
                <ResourceDictionary Source="Style/PartComponentStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type enums:AGR_ComponentType_e}" x:Key="ComponentTypeEnum"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <AGR_converter:AGR_EmptyCollectionToVisibilityConverter x:Key="AGR_EmptyCollectionToVisibilityConverter"/>
            <AGR_converter:AGR_ComponentTypeConverter x:Key="ComponentTypeConverter"/>
            <AGR_converter:AGR_GroupHeaderConverter x:Key="GroupHeaderConverter"/>
            <AGR_converter:AGR_NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <AGR_converter:AGR_InverseBooleanConverter x:Key="InverseBoolToVisibilityConverter"/>

            <ContextMenu  x:Key="RowMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Mode=Self}}">
                <MenuItem Header="Установить покрытие...">
                    <MenuItem Header="Найти артикул" CommandParameter="{Binding}" 
                        Command="{Binding DataContext.SetPaintCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"/>
                    <MenuItem Header="Без покрытия" CommandParameter="NoPaint"
                        Command="{Binding DataContext.SetPaintCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"/>
                </MenuItem>
            </ContextMenu>



            <!-- DataTemplate для отображения операций в ячейке -->
            <DataTemplate x:Key="OperationsTemplate" DataType="vmComp:ComponentItemViewModel">
                <DataGrid x:Name="OperationsGrid"
                    ItemsSource="{Binding Operations, NotifyOnSourceUpdated=True}"
                    AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="None"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    Visibility="{Binding Operations.Count, Converter={StaticResource AGR_EmptyCollectionToVisibilityConverter}}">


                    <DataGrid.Columns>
                        <!-- Номер операции (SequenceNumber) -->
                        <DataGridTextColumn Header="№" Binding="{Binding SequenceNumber}" Width="15" IsReadOnly="True"/>
                        <!-- Участок -->
                        <DataGridTextColumn Header="Участок" Binding="{Binding WorkstationName}" Width="2*" IsReadOnly="True"/>
                        <!-- Операция -->
                        <DataGridTextColumn Header="Операция" Binding="{Binding Name}" Width="3*" IsReadOnly="True"/>
                        <!-- Время -->
                        <DataGridTemplateColumn Header="Время" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CostPerHour, StringFormat='{}{0:F2} мин'}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CostPerHour,StringFormat='{}{0:F3}', UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DataContext.DeleteOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>

                </DataGrid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Toolbar -->
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>



            <!-- Toolbar -->
            <ToolBar Grid.Row="0" Grid.ColumnSpan="2">
                <Label Content="Группировка:"/>
                <ComboBox SelectedValue="{Binding SelectedGroupingMode}" SelectedValuePath="Content" Width="120" Margin="0,0,10,0">
                    <ComboBoxItem Content="По материалу"/>
                    <ComboBoxItem Content="По типу"/>
                </ComboBox>
                <Menu Grid.Row="0">
                    <MenuItem Header="Команды">
                        <MenuItem Header="Редактировать процесс" Command="{Binding InsertTechProcessCommand}" />
                        <MenuItem Header="Экспорт файлов" Command="{Binding ExportStorageFilesCommand}" />
                    </MenuItem>
                </Menu>
                <Menu Grid.Row="0">
                    <MenuItem Header="_Отчеты">
                        <MenuItem Header="Импорт классификатора" Command="{Binding ShowImportClassifierReportCommand}" />
                        <MenuItem Header="Импорт полного классификатора" Command="{Binding ShowImportFullClassifierReportCommand}" />
                        <MenuItem Header="Импорт дерева" Command="{Binding ShowTreeImportReportCommand}" />
                        <MenuItem Header="Импорт техопераций" Command="{Binding ShowTechOpsImportReportCommand}" />

                        
                    </MenuItem>
                </Menu>
            </ToolBar>


            <!-- Main DataGrid with grouping -->
            <DataGrid x:Name="ComponentsDataGrid"
                  Grid.Row="1" Grid.Column="0" Style="{StaticResource TechOpEditorDataGrid}"
                  ItemsSource="{Binding ComponentsView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  IsReadOnly="True" 
                      
                  AGR_Behavors:AGR_DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedComponents, Mode=TwoWay}">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.InputBindings>
                    <KeyBinding Key="Insert" Command="{Binding InsertTechProcessCommand}"/>
                    <KeyBinding Key="Space" Command="{Binding SelectComponentCommand}"/>
                </DataGrid.InputBindings>

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True" Background="#d2f9e6">
                                                <Expander.Header>
                                                    <DockPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Margin="10,5,5,5"
                                                           Foreground="#212121">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource GroupHeaderConverter}">
                                                                    <Binding Path="Name"/>
                                                                    <Binding Path="DataContext.SelectedGroupingMode" 
                                                             RelativeSource="{RelativeSource FindAncestor, 
                                                                 AncestorType={x:Type DataGrid}}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <TextBlock FontWeight="Bold" 
                                                               Margin="0 5"
                                                               FontSize="14"
                                                               Text="{Binding ItemCount, StringFormat='({0})'}"
                                                               Foreground="#616161"/>
                                                    </DockPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <!-- CheckBox Column -->
                    <DataGridTemplateColumn CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Preview -->
                    <DataGridTemplateColumn CanUserResize="False">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="white"/>
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <Image Source="{Binding PreviewImage}" Width="800"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="50" />
                                <Setter Property="ToolTipService.Placement" Value="Mouse"/>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vmComp:ComponentItemViewModel}">
                                <Image Source="{Binding PreviewImage}" MaxHeight="50" MaxWidth="50" Stretch="Uniform"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PartNumber / Article -->
                    <DataGridTemplateColumn Header="Partnumber / Артикул"  SortMemberPath="PartNumber" Width="SizeToHeader">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBox Text="{Binding PartNumber, Mode=OneWay}" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Background="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow, Mode=FindAncestor}}"/>
                                    <TextBox Text="{Binding AvaArticle.Article, StringFormat=Артикул№0 , Mode=OneWay}" BorderThickness="0"
                                             Background="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow, Mode=FindAncestor}}"
                                             Visibility="{Binding AvaArticle, Converter={StaticResource NullToVisibilityConverter}}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                             Foreground="BlueViolet"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name -->
                    <DataGridTemplateColumn Header="Наименование" SortMemberPath="Name" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AvaArticle.Name}" VerticalAlignment="Center" Foreground="BlueViolet"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Material -->
                    <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="2*"
                                    ElementStyle="{StaticResource LeftAlignedTextStyle}" Visibility="Collapsed"/>

                    <DataGridTemplateColumn Header="Материалы" SortMemberPath="Material">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Material}" Visibility="{Binding Material, Converter={StaticResource NullToVisibilityConverter}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Paint}" Visibility="{Binding Paint, Converter={StaticResource NullToVisibilityConverter}}" VerticalAlignment="Center"
                                               Foreground="BlueViolet"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Paint -->
                    <DataGridTextColumn Header="Покраска" Binding="{Binding Paint}" Width="SizeToHeader"
                                    ElementStyle="{StaticResource LeftAlignedTextStyle}" Visibility="Collapsed"/>

                    <!-- Bend Count -->
                    <DataGridTextColumn Header="Сгибы" Binding="{Binding BendCount}" Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterAlignedTextStyle}"/>

                    <!-- Contour Length -->
                    <DataGridTextColumn Header="Контур" Binding="{Binding ContourLength}" Width="SizeToCells"
                                    ElementStyle="{StaticResource CenterAlignedTextStyle}"/>

                    <!-- Tech Process Column -->
                    <DataGridTemplateColumn Header="Техпроцесс" CellTemplate="{StaticResource OperationsTemplate}" Width="5*" />

                </DataGrid.Columns>

            </DataGrid>

            <!-- Панель ошибок справа -->
            <Border Grid.Column="1" Grid.Row="1"
                    Style="{StaticResource ErrorBorderStyle}"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Ошибки:" 
                               FontWeight="Bold" 
                               Style="{StaticResource ErrorTextblockStyle}"/>
                        <TextBlock Text="{Binding Errors}"
                               Style="{StaticResource ErrorTextblockStyle}"/>
                        <TextBlock Text="{Binding Warnings}" 
                                Style="{StaticResource WarningTextblockStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Buttons Panel -->
            <StackPanel Visibility="Collapsed" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,10,0"/>
                <Button Content="Закрыть" Command="{Binding CloseCommand}" Width="100" IsCancel="True"/>
            </StackPanel>
        </Grid>
        <Border Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="{Binding LoadingStatus}" 
                           Foreground="White" 
                           FontSize="16" 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
